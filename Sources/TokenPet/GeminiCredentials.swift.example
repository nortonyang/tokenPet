// GeminiCredentials.swift.example
//
// Copy this file to GeminiCredentials.swift and fill in your values.
// GeminiCredentials.swift is gitignored and will never be committed.
//
// These are the OAuth 2.0 Desktop App credentials used to refresh
// the access token stored in ~/.gemini/oauth_creds.json.
// You can obtain these from the Gemini CLI (antigravity-cli) source code,
// or register your own OAuth client at https://console.cloud.google.com/

struct GeminiCredentials {
    static let clientId     = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
    static let clientSecret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
}
